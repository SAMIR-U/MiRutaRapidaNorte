# Copia este archivo como .env (no lo subas a GitHub; ya está en .gitignore)

# Puerto local. En Render se asigna solo, no lo definas allí.
PORT=3000

# Postgres para conservar el estado entre reinicios (recomendado en Render).
# Déjalo vacío para usar el archivo JSON local (data/state.json).
# En Render, usa la "Internal Database URL" si el servicio y la base están en la misma región.
DATABASE_URL=

# Penalización (segundos) por cada parada que se omite. Más alto = menos saltos recomendados.
SKIP_PENALTY=45

# Ruta del archivo JSON si no usas Postgres (opcional).
# STATE_FILE=./data/state.json
